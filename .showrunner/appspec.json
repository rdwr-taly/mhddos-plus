{
  "capabilities": {
    "can_redeploy": true,
    "can_resume": true,
    "can_schedule": false,
    "can_stop": true,
    "can_update_while_running": false
  },
  "category": "Security Tools",
  "deployment": {
    "default_env_vars": [
      {
        "default_value": "1h",
        "label": "Attack Interval (e.g., 1h, 30m, 5s)",
        "name": "CRON_SCHEDULE",
        "tooltip": "The interval for the internal scheduler to repeat the attack sequence. Use 's' for seconds, 'm' for minutes, 'h' for hours, 'd' for days.",
        "type": "string"
      },
      {
        "default_value": 0,
        "label": "Start Delay (minutes from now)",
        "name": "START_TIME_OFFSET_MINUTES",
        "tooltip": "Delay in minutes before the first attack cycle begins.",
        "type": "integer"
      },
      {
        "default_value": "[{\"name\":\"Initial GET Flood\",\"MHDDOS_METHOD\":\"GET\",\"MHDDOS_TARGET_URL\":\"https://httpbin.org/get\",\"MHDDOS_PROXY_TYPE\":\"1\",\"MHDDOS_THREADS\":500,\"MHDDOS_PROXY_FILE\":\"http.txt\",\"MHDDOS_RPC\":100,\"MHDDOS_DURATION_SECONDS\":300,\"MHDDOS_COOKIE\":\"\",\"MHDDOS_THROUGHPUT_MBPS\":10,\"MHDDOS_LATENCY_MS\":0}]",
        "item_name_label": "Phase Name",
        "label": "Attack Phases",
        "name": "SUB_TASK_CONFIGS_JSON",
        "sub_fields_ref": [
          "name",
          "MHDDOS_METHOD",
          "MHDDOS_TARGET_URL",
          "MHDDOS_PROXY_TYPE",
          "MHDDOS_THREADS",
          "MHDDOS_PROXY_FILE",
          "MHDDOS_RPC",
          "MHDDOS_DURATION_SECONDS",
          "MHDDOS_COOKIE",
          "MHDDOS_THROUGHPUT_MBPS",
          "MHDDOS_LATENCY_MS"
        ],
        "tooltip": "Define one or more attack phases to run sequentially in each cycle. To change this, you must stop and redeploy the task.",
        "type": "string",
        "ui_type": "field_group_list"
      },
      {
        "default_value": "Phase 1",
        "is_item_identifier": true,
        "label": "Phase Name",
        "name": "name",
        "type": "string"
      },
      {
        "default_value": "GET",
        "label": "Method",
        "name": "MHDDOS_METHOD",
        "options": [
          "GET",
          "POST",
          "STRESS",
          "HEAD",
          "EVEN",
          "CFB",
          "BYPASS",
          "COOKIE",
          "TCP",
          "UDP",
          "SYN",
          "KILLER",
          "SLOW",
          "AVB"
        ],
        "type": "select"
      },
      {
        "default_value": "https://httpbin.org/get",
        "label": "Target (URL or IP:Port)",
        "name": "MHDDOS_TARGET_URL",
        "required": true,
        "type": "string"
      },
      {
        "default_value": "1",
        "label": "Proxy Type",
        "name": "MHDDOS_PROXY_TYPE",
        "options": [
          "1",
          "4",
          "5",
          "0"
        ],
        "tooltip": "Select the type of proxy to use for this phase (1=HTTP, 4=SOCKS4, 5=SOCKS5, 0=All).",
        "type": "select"
      },
      {
        "default_value": 500,
        "label": "Threads",
        "name": "MHDDOS_THREADS",
        "type": "integer"
      },
      {
        "default_value": "http.txt",
        "label": "Proxy List File",
        "name": "MHDDOS_PROXY_FILE",
        "tooltip": "Filename of the proxy list within files/proxies/",
        "type": "string"
      },
      {
        "default_value": 100,
        "label": "Reqs Per Conn",
        "name": "MHDDOS_RPC",
        "type": "integer"
      },
      {
        "default_value": 300,
        "label": "Duration (s)",
        "name": "MHDDOS_DURATION_SECONDS",
        "type": "integer"
      },
      {
        "label": "Custom Cookie",
        "name": "MHDDOS_COOKIE",
        "required": false,
        "tooltip": "Optional. Custom cookie string to be sent with requests.",
        "type": "string"
      },
      {
        "default_value": 10,
        "label": "Bandwidth (Mbps)",
        "max": 1000,
        "min": 1,
        "name": "MHDDOS_THROUGHPUT_MBPS",
        "tooltip": "Max bandwidth for this phase.",
        "type": "integer"
      },
      {
        "default_value": 0,
        "label": "Latency (ms)",
        "max": 5000,
        "min": 0,
        "name": "MHDDOS_LATENCY_MS",
        "tooltip": "Simulated network latency for this phase.",
        "type": "integer"
      },
      {
        "default_value": false,
        "label": "Auto-Remove on Stop",
        "name": "AUTO_REMOVE_CONTAINER",
        "tooltip": "If true, container will self-destruct after a manual stop. Set to false for a persistent stateful service.",
        "type": "boolean"
      }
    ],
    "sdk_config_template": {
      "auto_remove": "{{env.AUTO_REMOVE_CONTAINER}}",
      "cron_schedule": "{{env.CRON_SCHEDULE}}",
      "start_time": "{{calculated_utc_start_time_from_offset_env.START_TIME_OFFSET_MINUTES}}",
      "sub_tasks": "{{json_rename_keys(env.SUB_TASK_CONFIGS_JSON, _itemName->name|name->name|MHDDOS_METHOD->Method|MHDDOS_TARGET_URL->Target URL|MHDDOS_PROXY_TYPE->Type|MHDDOS_THREADS->Threads|MHDDOS_PROXY_FILE->Proxy List File|MHDDOS_RPC->RPC|MHDDOS_DURATION_SECONDS->Duration (seconds)|MHDDOS_COOKIE->Cookie|MHDDOS_THROUGHPUT_MBPS->throughput_in_mbps|MHDDOS_LATENCY_MS->latency_in_ms)}}"
    }
  },
  "deploymentContext": "app",
  "description": "A stateful MHDDoS attacker with internal scheduling for creating complex, recurrent attack patterns. The container manages its own lifecycle as a long-running service.",
  "displayName": "MHDDoS Plus (Stateful Attacker)",
  "icon": "fas fa-server",
  "id": "mhddos-plus",
  "image_id_ref": "razor29/mhddos-plus",
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "scrape_path": "/metrics",
      "scrape_port_number": 9090
    }
  },
  "subCategory": "DDoS Attack (Stateful)",
  "taskLifecycle": "stateful",
  "ui": {
    "card_basic_metrics": [
      {
        "label": "CPU",
        "max_value": 100,
        "source_path": "system.cpu_percent",
        "unit": "%"
      },
      {
        "label": "Memory",
        "max_value": 100,
        "source_path": "system.memory_percent",
        "unit": "%"
      }
    ],
    "card_info_fields": [
      {
        "label": "Next Run",
        "source_key": "",
        "source_type": "task_db"
      }
    ],
    "card_primary_metric": [
      {
        "label": "Outgoing",
        "source_path": "mhddos_outgoing_throughput_mbps",
        "unit": "Mbps"
      },
      {
        "label": "Incoming",
        "source_path": "mhddos_incoming_throughput_mbps",
        "unit": "Mbps"
      }
    ],
    "card_secondary_metrics": [
      {
        "label": "Running Task",
        "source_path": "mhddos_running_task",
        "unit": ""
      }
    ],
    "deployment_form_sections": [
      {
        "fields": [
          "CRON_SCHEDULE",
          "START_TIME_OFFSET_MINUTES",
          "AUTO_REMOVE_CONTAINER"
        ],
        "title": "Scheduling"
      },
      {
        "fields": [
          "SUB_TASK_CONFIGS_JSON"
        ],
        "title": "Attack Phases"
      }
    ]
  }
}
